# Persistence and authentication (replace placeholders locally).
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/label_lens
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini label extraction and product Q&A. Keep API keys server-side.
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=12

# Optional legacy aliases for Gemini Vision; AI_API_KEY and AI_MODEL take precedence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional path to the separately installed Tesseract executable.
TESSERACT_CMD=

# Comma-separated browser origins. Credentials require explicit origins;
# do not use "*" with CORS_ALLOW_CREDENTIALS=true.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_CREDENTIALS=true

# Per-client, per-operation limits, held in this process's memory.
EXTRACT_LABEL_RATE_LIMIT_REQUESTS=10
EXTRACT_LABEL_RATE_LIMIT_WINDOW_SECONDS=60
PRODUCT_ASK_RATE_LIMIT_REQUESTS=20
PRODUCT_ASK_RATE_LIMIT_WINDOW_SECONDS=60
